rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { 
      return isVerified() && request.auth.token.email == 'khalidyoussef7@gmail.com';
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validation ---
    function isValidMessage(msg) {
      return (msg.keys().hasAll(['text', 'senderName', 'senderColor', 'timestamp']) || msg.keys().hasAll(['image', 'senderName', 'senderColor', 'timestamp'])) &&
             msg.senderName is string && msg.senderName.size() <= 50 &&
             msg.senderColor is string && msg.senderColor.size() <= 10 &&
             (!('text' in msg) || (msg.text is string && msg.text.size() <= 1000)) &&
             (!('image' in msg) || (msg.image is string && msg.image.size() <= 1000000)) &&
             msg.timestamp == request.time;
    }

    function isValidShift(sh) {
      return sh.off is bool && sh.s is list && sh.s.size() <= 24;
    }

    function isValidDay(day) {
      return day.id is string && day.id.size() <= 10 &&
             day.full is string && day.full.size() <= 20 &&
             day.date is string && day.date.size() <= 10 &&
             day.shifts is list && day.shifts.size() <= 50;
    }

    function isValidPlanning(data) {
      return data.monday is string && data.monday.size() <= 64 &&
             data.data is list && data.data.size() == 7 &&
             data.employees is list && data.employees.size() <= 50 &&
             (data.keys().hasAll(['updatedAt']) ? data.updatedAt == request.time : true);
    }

    // --- Routes ---
    match /chat/general/messages/{messageId} {
      // Anyone logged in can read and write to the general chat
      allow read: if true; // or if isSignedIn() depending on if unauthenticated employees can see it
      allow create: if true && isValidMessage(incoming()); 
      // No updates or deletes for simplicty, or only admins can delete
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /plannings/{weekId} {
      // Employees might not have accounts, so they might view via a public link.
      // But the user asked for roles and permissions. I'll stick to Auth.
      allow get: if true; 
      allow list: if isSignedIn();
      
      allow create: if (isAdmin()) && isValidId(weekId) && isValidPlanning(incoming());
      
      allow update: if (isAdmin()) && isValidId(weekId) && isValidPlanning(incoming()) && (
        incoming().monday == existing().monday
      );
      
      allow delete: if isAdmin();
    }
  }
}
